<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp"
        android:minHeight="1000dp">

        <!-- ==================== 顶部区域 ==================== -->
        <!-- 状态栏占位 + 顶部图标 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_arrow_back" />

            <ImageView
                android:id="@+id/iv_message"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_message" />

        </RelativeLayout>

        <!-- Logo + 店名（居中） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:orientation="vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/logo_image"
                android:layout_width="108dp"
                android:layout_height="107dp"
                android:src="@drawable/logo"
                app:civ_border_color="@color/white"
                app:civ_border_width="1.5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.02"
                android:text="艺黎奶茶铺"
                android:textColor="@color/purple_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ==================== Banner轮播区 ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/banner_viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <!-- Banner指示器圆点 -->
        <LinearLayout
            android:id="@+id/banner_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp" />

        <!-- ==================== 外卖/自取选择栏 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp">

            <LinearLayout
                android:id="@+id/ll_takeout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_takeout_selected"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_takeout_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_scooter" />

                <TextView
                    android:id="@+id/tv_takeout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外卖"
                    android:textSize="16sp"
                    android:textColor="@color/p_black"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_selfpickup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_takeout_normal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_selfpickup_check"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_milk_tea" />

                <TextView
                    android:id="@+id/tv_selfpickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自取"
                    android:textSize="16sp"
                    android:textColor="@color/p_black"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== 爆款饮品展示区 ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 人气爆款 🔥"
            android:textSize="18sp"
            android:textColor="@color/purple_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hot_drinks_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>